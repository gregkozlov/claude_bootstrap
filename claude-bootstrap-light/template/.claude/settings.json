{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the call against the repo's prohibitions"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git apply:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git submodule:*)",
      "Bash(git worktree add:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git am:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git stash)",
      "Bash(git stash -*)",
      "Bash(git stash push:*)",
      "Bash(git stash save:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash apply:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git stash branch:*)",
      "Bash(git stash create:*)",
      "Bash(git stash store:*)",
      "Bash(git worktree remove:*)",
      "Bash(git branch -D:*)",
      "Bash(git update-ref:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git add:*)",
      "PowerShell(git apply:*)",
      "PowerShell(git rm:*)",
      "PowerShell(git mv:*)",
      "PowerShell(git submodule:*)",
      "PowerShell(git worktree add:*)",
      "PowerShell(git push:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git reset:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git cherry-pick:*)",
      "PowerShell(git revert:*)",
      "PowerShell(git am:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git stash)",
      "PowerShell(git stash -*)",
      "PowerShell(git stash push:*)",
      "PowerShell(git stash save:*)",
      "PowerShell(git stash pop:*)",
      "PowerShell(git stash apply:*)",
      "PowerShell(git stash drop:*)",
      "PowerShell(git stash clear:*)",
      "PowerShell(git stash branch:*)",
      "PowerShell(git stash create:*)",
      "PowerShell(git stash store:*)",
      "PowerShell(git worktree remove:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git update-ref:*)"
    ],
    "allow": [
      "Bash(<CHECK_COMMAND>)",
      "Bash(<CHECK_COMMAND>:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(sed -n:*)",
      "Bash(node .claude/hooks/tests/guard-test.mjs)",
      "Bash(node .claude/hooks/tests/guard-shell-test.mjs)",
      "PowerShell(<CHECK_COMMAND>)",
      "PowerShell(<CHECK_COMMAND>:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git check-ignore:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(node .claude/hooks/tests/guard-test.mjs)",
      "PowerShell(node .claude/hooks/tests/guard-shell-test.mjs)"
    ]
  }
}
